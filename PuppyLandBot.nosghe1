DATA_FILE = "puppyland_data.json"

PAW_COOLDOWN = 6 * 60          # 6 دقیقه
MIN_GROUP_MEMBERS = 8          # حداقل اعضای گروه

START_PAW = 0

# ---------------------------------------------------------
# 📝 لاگ
# ---------------------------------------------------------

logging.basicConfig(
    format="%(asctime)s - %(name)s - %(levelname)s - %(message)s",
    level=logging.INFO,
)

logger = logging.getLogger(__name__)o


# =========================================================
# 💾 سیستم ذخیره‌سازی
# =========================================================

def load_data():
    if not os.path.exists(DATA_FILE):
        return {}

    try:
        with open(DATA_FILE, "r", encoding="utf-8") as file:
            return json.load(file)

    except Exception:
        return {}


def save_data():
    try:
        with open(DATA_FILE, "w", encoding="utf-8") as file:
            json.dump(
                users,
                file,
                ensure_ascii=False,
                indent=2
            )

    except Exception as error:
        logger.error(f"خطا در ذخیره اطلاعات: {error}")


users = load_data()


# =========================================================
# 👤 ساخت پروفایل کاربر
# =========================================================

def get_user(user):

    user_id = str(user.id)

    if user_id not in users:

        users[user_id] = {
            "id": user.id,
            "name": user.first_name or "پاپی",
            "username": user.username or "",

            "paw_points": START_PAW,

            "pet_name": "پاپی",
            "pet_type": "🐶 سگ",
            "pet_level": 1,

            "last_paw": 0,

            "created": int(time.time()),
        }

        save_data()

    else:

        users[user_id]["name"] = user.first_name or users[user_id].get(
            "name",
            "پاپی"
        )

        users[user_id]["username"] = user.username or ""

    return users[user_id]


# =========================================================
# 👥 بررسی گروه ۸ نفره
# =========================================================

async def is_valid_group(update: Update):

    chat = update.effective_chat

    if chat.type not in ["group", "supergroup"]:
        return True

    try:

        member_count = await chat.get_member_count()

        return member_count >= MIN_GROUP_MEMBERS

    except Exception:

        # اگر تلگرام تعداد اعضا را نداد،
        # فعلاً اجازه ادامه می‌دهیم.
        return True


async def group_limit_message(update: Update):

    await update.effective_message.reply_text(
        "🐶✨ پاپی‌لند برای بازی گروهی ساخته شده!\n\n"
        "👥 برای فعال شدن امکانات بازی در این گروه، "
        "حداقل ۸ عضو لازم است.\n\n"
        "🐾 وقتی گروه به ۸ نفر رسید، پاپی‌لند آماده بازیه! 🎮✨"
    )


