# =========================================================
# 🔘 CALLBACKS
# =========================================================

async def button_handler(
    update: Update,
    context: ContextTypes.DEFAULT_TYPE
):

    query = update.callback_query

    await query.answer()

    data = query.data

    # -------------------------
    # HELP
    # -------------------------

    if data == "help":
        await help_menu(update, context)

    elif data == "help_start":

        text = (
            "🐾 **شروع پاپی‌لند** 🐶✨\n\n"

            "برای شروع، پاپی‌لند رو به یک گروه اضافه کن.\n\n"

            "👥 گروه باید حداقل ۸ عضو داشته باشه.\n\n"

            "بعد از فعال شدن بازی می‌تونی از:\n\n"

            "🐾 «پاو»\n"
            "🐶 «پاپی»\n"
            "👤 «پروفایل پاپی»\n"
            "👤 «پاوهام»\n\n"

            "استفاده کنی."
        )

        keyboard = [
            [
                InlineKeyboardButton(
                    "🔙 بازگشت",
                    callback_data="help"
                )
            ]
        ]

        await query.edit_message_text(
            text,
            parse_mode="Markdown",
            reply_markup=InlineKeyboardMarkup(keyboard)
        )

    elif data == "help_features":

        text = (
            "✨ **قابلیت‌های پاپی** 🐶\n\n"

            "🐾 دریافت پاوپوینت\n"
            "🐶 مشاهده اطلاعات پاپی\n"
            "👤 مشاهده پروفایل\n"
            "💾 ذخیره پیشرفت\n"
            "👥 بازی در گروه\n"
            "⏱️ سیستم تایمر\n\n"

            "🚀 این فقط نسخه اول پاپی‌لنده!"
        )

        keyboard = [
            [
                InlineKeyboardButton(
                    "🔙 بازگشت",
                    callback_data="help"
                )
            ]
        ]

        await query.edit_message_text(
            text,
            parse_mode="Markdown",
            reply_markup=InlineKeyboardMarkup(keyboard)
        )

    elif data == "help_system":

        text = (
            "⚙️ **سیستم پاپی‌لند** 🐶\n\n"

            "🐾 پاو = دریافت پاوپوینت\n"
            "🐶 پاپی = اطلاعات حیوان\n"
            "👤 پروفایل پاپی = اطلاعات کاربر\n"
            "👤 پاوهام = اطلاعات کلی کاربر\n\n"

            "⏱️ دریافت پاو هر ۶ دقیقه یک‌بار انجام می‌شود.\n\n"

            "💾 اطلاعات کاربران ذخیره می‌شود."
        )

        keyboard = [
            [
                InlineKeyboardButton(
                    "🔙 بازگشت",
                    callback_data="help"
                )
            ]
        ]

        await query.edit_message_text(
            text,
            parse_mode="Markdown",
            reply_markup=InlineKeyboardMarkup(keyboard)
        )

    # -------------------------
    # RULES
    # -------------------------

    elif data == "rules_1":

        await rules_page_1(update, context)

    elif data == "rules_2":

        await rules_page_2(update, context)

    # -------------------------
    # BACK
    # -------------------------

    elif data == "back_start":

        user = get_user(update.effective_user)

        keyboard = [
            [
                InlineKeyboardButton(
                    "❓ راهنمای پاپی‌لند",
                    callback_data="help"
                )
            ],
            [
                InlineKeyboardButton(
                    "📜 قوانین",
                    callback_data="rules_1"
                )
            ],
        ]

        text = (
            "🐶✨ **PuppyLand**\n\n"
            f"خوش برگشتی {user['name']} جان! 🐾❤️\n\n"
            "از منوی زیر انتخاب کن:"
        )

        await query.edit_message_text(
            text,
            parse_mode="Markdown",
            reply_markup=InlineKeyboardMarkup(keyboard)
        )


