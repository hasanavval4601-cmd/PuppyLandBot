# =========================================================
# 🐾 PAW
# =========================================================

async def paw(update: Update, context: ContextTypes.DEFAULT_TYPE):

    # فقط پیام واقعی
    if not update.effective_user:
        return

    # بررسی گروه
    if update.effective_chat.type in ["group", "supergroup"]:

        valid = await is_valid_group(update)

        if not valid:
            await group_limit_message(update)
            return

    user = get_user(update.effective_user)

    now = int(time.time())

    last_paw = user.get("last_paw", 0)

    remaining = PAW_COOLDOWN - (now - last_paw)

    if remaining > 0:

        minutes = remaining // 60
        seconds = remaining % 60

        await update.effective_message.reply_text(
            "🐾⏳ پاپی هنوز آماده نیست!\n\n"
            f"⏱️ زمان باقی‌مانده: **{minutes} دقیقه و {seconds} ثانیه**\n\n"
            "✨ دوباره بعداً امتحان کن!"
            ,
            parse_mode="Markdown"
        )

        return

    # دریافت Paw
    reward = 1

    user["paw_points"] += reward
    user["last_paw"] = now

    save_data()

    await update.effective_message.reply_text(
        "🐾✨ **پاو!**\n\n"
        f"🎁 +{reward} پاوپوینت\n"
        f"💰 موجودی: **{user['paw_points']} پاوپوینت**\n\n"
        "⏱️ تایمر ۶ دقیقه‌ای فعال شد!\n"
        "🐶✨ پاپی منتظرته..."
        ,
        parse_mode="Markdown"
    )


